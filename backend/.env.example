# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://reachinbox_user:<YOUR_PASSWORD>@localhost:5432/reachinbox_db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ethereal Email (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your_username
SMTP_PASS=your_password

SMTP_FROM="ReachInbox <no-reply@reachinbox.local>"